---
// Portada mínima con el esqueleto; la Tarea 6 pone la línea de tiempo y las tarjetas.
import BaseLayout from '../comun/BaseLayout.astro';
import { asignaturasOrdenadas } from '../comun/datos';
import { ruta } from '../comun/rutas';
const asignaturas = await asignaturasOrdenadas();
---
<BaseLayout titulo="Apuntes GITT 4º">
  <main id="contenido" class="envoltura">
    <h1>Apuntes GITT 4º</h1>
    <ul>
      {asignaturas.map((a) => (
        <li>{a.estado === 'activa' ? <a href={ruta(a.slug)}>{a.nombre}</a> : <span>{a.nombre} (en preparación)</span>}</li>
      ))}
    </ul>
  </main>
</BaseLayout>
