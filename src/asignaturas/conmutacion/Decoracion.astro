---
// Cordones de la centralita colgando en los márgenes libres. Solo decoran:
// aria-hidden, sin eventos de ratón, detrás del contenido y ocultos si no hay hueco.
---
<div class="cx-deco" aria-hidden="true">
  <svg class="cx-deco-lado cx-deco-izq" viewBox="0 0 200 900" preserveAspectRatio="xMinYMin meet">
    <path class="cordon rojo" d="M150 0 C150 160 40 200 60 340 S170 520 120 660 S40 820 70 900" />
    <path class="cordon laton" d="M180 0 C180 120 110 260 130 400 S60 620 100 760 S150 860 140 900" />
    <circle class="clavija-deco" cx="60" cy="340" r="9" />
    <circle class="clavija-deco" cx="130" cy="400" r="9" />
  </svg>
  <svg class="cx-deco-lado cx-deco-der" viewBox="0 0 200 900" preserveAspectRatio="xMaxYMin meet">
    <path class="cordon laton" d="M30 0 C30 140 140 220 120 380 S20 560 70 700 S160 840 130 900" />
    <path class="cordon rojo" d="M60 0 C60 200 160 300 150 470 S60 700 90 900" />
    <circle class="clavija-deco" cx="120" cy="380" r="9" />
    <circle class="clavija-deco" cx="150" cy="470" r="9" />
  </svg>
</div>
