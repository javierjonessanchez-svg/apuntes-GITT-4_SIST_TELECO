---
// Una clavija del cuadro: nombre del tema y una fila de tres lámparas, una por
// paso del avance: leído (1), repasado (2) y dominado (3, las tres con brillo).
// cliente/avance.ts pone data-nivel y el texto del estado.
import { ruta } from '../../comun/rutas';
import type { Tema } from '../../comun/datos';

interface Props { asignatura: string; tema: Tema; i: number }
const { asignatura, tema, i } = Astro.props;
---
<a class="clavija" href={ruta(asignatura, tema.slug)} data-avance data-asig={asignatura} data-tema={tema.slug} data-nivel="0" style={`--i:${i}`}>
  <span class="clavija-nombre">{tema.titulo}</span>
  <span class="clavija-sub">{tema.resumen}</span>
  <span class="clavija-pie">
    <span class="cx-pasos" aria-hidden="true"><span class="lampara"></span><span class="lampara"></span><span class="lampara"></span></span>
    <span class="clavija-estado" data-avance-texto>Sin empezar</span>
  </span>
</a>
