---
// Marco común de las figuras del resumen de examen: figura con pie, desplazable en el móvil
// y con las clases del dibujo (ejes, TC, señales, cotas) para que todas se vean igual.
interface Props { alt: string; ancho?: number }
const { alt, ancho = 560 } = Astro.props;
---
<figure class="sd-fig">
  <div class="desliza" role="img" aria-label={alt} style={`--ancho:${ancho}px`}>
    <slot name="dibujo" />
  </div>
  <figcaption><slot /></figcaption>
</figure>

<style is:global>
  .sd-fig { margin: 16px 0 22px; }
  .sd-fig svg { display: block; width: 100%; min-width: var(--ancho, 560px); height: auto; font-family: var(--fuente-mono); font-variant-ligatures: none; }
  .sd-fig figcaption { margin-top: 6px; font-size: .88rem; color: var(--suave); text-wrap: pretty; }
  .sd-fig .eje { fill: none; stroke: var(--suave); stroke-width: 1.4; }
  .sd-fig .tc { fill: none; stroke: var(--primario); stroke-width: 2.2; stroke-linejoin: round; }
  .sd-fig .sen { fill: none; stroke: var(--texto); stroke-width: 2.4; stroke-linejoin: round; }
  .sd-fig .nivel { fill: none; stroke: var(--acento); stroke-width: 1.4; stroke-dasharray: 6 4; }
  .sd-fig .guia { fill: none; stroke: var(--linea); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .sd-fig .cota { fill: none; stroke: var(--suave); stroke-width: 1.4; }
  .sd-fig .caja { fill: var(--superficie); stroke: var(--serigrafia); stroke-width: 1.5; }
  .sd-fig .caja.fuerte { fill: color-mix(in srgb, var(--primario) 10%, var(--superficie)); stroke: var(--primario); }
  .sd-fig .flecha { fill: none; stroke: var(--suave); stroke-width: 1.6; }
  .sd-fig .punta { fill: var(--suave); stroke: none; }
  .sd-fig .isr { fill: var(--resalte); stroke: var(--texto); stroke-width: 1.2; }
  .sd-fig .t { font-size: 12px; fill: var(--suave); }
  .sd-fig .tb { font-size: 13px; font-weight: 700; fill: var(--texto); }
  .sd-fig .tp { font-size: 13px; font-weight: 700; fill: var(--primario); }
  .sd-fig .tn { font-size: 13px; font-weight: 700; fill: var(--acento); }
  .sd-fig .tr { font-size: 13px; font-weight: 700; fill: var(--acento2); }
  .sd-fig .c { text-anchor: middle; }
  .sd-fig .relleno { fill: color-mix(in srgb, var(--primario) 18%, transparent); stroke: none; }
</style>
