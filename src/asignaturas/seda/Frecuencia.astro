---
// Aviso de cuánto cae un apartado en los exámenes de otros años y qué conviene practicar.
// Solo recuentos y tipos de pregunta: ningún enunciado, dato ni solución de los exámenes.
interface Props {
  // «10 de 13», para el recuento de exámenes (los 13 con solución que hay en la carpeta de clase)
  sale: string;
  // En qué pruebas suele aparecer: «PEI1», «PEI2 y final»…
  donde: string;
  // Qué hay que saber hacer (una frase corta)
  practica: string;
  // Opcional: 'alta' (por defecto), 'media' o 'baja', solo cambia el color del aviso
  peso?: 'alta' | 'media' | 'baja';
}
const { sale, donde, practica, peso = 'alta' } = Astro.props;
const etiqueta = { alta: 'Cae casi siempre', media: 'Cae a menudo', baja: 'Cae menos' }[peso];
---
<aside class={`sd-freq sd-freq-${peso}`} aria-label="Cuánto cae en los exámenes">
  <p class="sd-freq-cab"><span class="sd-freq-punto" aria-hidden="true"></span><b>{etiqueta}</b> · {sale} exámenes · {donde}</p>
  <p class="sd-freq-txt"><b>Practica:</b> {practica}</p>
</aside>

<style>
  .sd-freq {
    --sd-freq-color: var(--acento);
    margin: 4px 0 18px; padding: 9px 14px 10px 16px; border-radius: 12px; line-height: 1.45; font-size: .9rem;
    background: color-mix(in srgb, var(--sd-freq-color) 8%, var(--superficie));
    box-shadow: inset 3px 0 0 var(--sd-freq-color), inset 0 0 0 1px color-mix(in srgb, var(--sd-freq-color) 25%, var(--linea));
  }
  .sd-freq-media { --sd-freq-color: var(--primario); }
  .sd-freq-baja { --sd-freq-color: var(--suave); }
  .sd-freq p { margin: 0; }
  .sd-freq-cab { display: flex; align-items: center; gap: 8px; font-size: .82rem; color: var(--suave); }
  .sd-freq-cab b { color: var(--texto); font-weight: 700; }
  .sd-freq-punto { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--sd-freq-color); }
  .sd-freq-txt { margin-top: 3px; color: var(--texto); }
  .sd-freq-txt b { font-weight: 650; }
</style>
