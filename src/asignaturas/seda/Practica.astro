---
// Aviso de que una parte del tema sale en una práctica del proyecto y conviene dominarla.
// Solo el número y el nombre de la práctica: ningún dato, paso ni código de los guiones.
interface Props { n: number; nombre: string }
const { n, nombre } = Astro.props;
---
<p class="sd-practica">
  <span class="sd-practica-pin" aria-hidden="true"></span>
  <span><b>Práctica {n}</b> ({nombre}) · conviene dominarlo</span>
</p>

<style>
  .sd-practica {
    display: inline-flex; align-items: center; gap: 8px; margin: -4px 0 14px; padding: 4px 12px 4px 10px;
    border-radius: 999px; font-size: .85rem; line-height: 1.4; color: var(--texto);
    background: color-mix(in srgb, var(--primario) 9%, var(--superficie));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primario) 28%, var(--linea));
  }
  .sd-practica b { font-weight: 650; color: var(--primario); }
  .sd-practica-pin { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--pad); box-shadow: 0 0 0 2px color-mix(in srgb, var(--pad) 35%, transparent); }
</style>
