---
// Las cinco asignaturas: la actual resaltada; las pendientes se ven, pero no son enlaces.
import { asignaturasOrdenadas } from './datos';
import { ruta } from './rutas';

interface Props { actual: string }
const { actual } = Astro.props;
const asignaturas = await asignaturasOrdenadas();
---
<nav class="selector" aria-label="Asignaturas" data-selector>
  <ul>
    {asignaturas.map((a) => (
      <li>
        {a.estado === 'activa' ? (
          <a class="chip" href={ruta(a.slug)} data-chip={a.slug} aria-current={a.slug === actual ? 'page' : undefined}
            title={a.nombre}>{a.corto}</a>
        ) : (
          <span class="chip pendiente" data-chip={a.slug} title={`${a.nombre}: en preparación`}>
            <span>{a.corto}</span> <span class="sr">En preparación</span>
          </span>
        )}
      </li>
    ))}
  </ul>
</nav>
